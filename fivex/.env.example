# Copy this file to ".env" in the same directory (fivex/) and fill in real values.
# Never commit the real ".env" file — it is already covered by .gitignore.

# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (your frontend URLs).
CLIENT_ORIGINS=http://localhost:5173,https://your-codespace-name-5173.app.github.dev

# ---- MongoDB ----
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/isittrue?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/isittrue

# ---- Auth / JWT ----
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# ---- Email verification ----
# Token lifetime for the "verify your email" link sent at signup.
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=60
# Public URL of the frontend, used to build links inside emails.
APP_URL=http://localhost:5173

# ---- Outgoing mail (Unosend) ----
# Create a key at https://unosend.co (keys start with "un_"). In development, leave it blank to
# log emails to the console instead of sending them.
UNOSEND_API_KEY=
UNOSEND_BASE_URL=https://api.unosend.co
# The sender must be on a domain you have verified in Unosend.
MAIL_FROM="IsItTrue News <no-reply@isittruenews.com>"

# ---- Pre-launch landing page ----
# Frontend: set VITE_PRE_LAUNCH=true to show only the waitlist landing page. Leave it unset
# (e.g. in local development) to use the full app.
VITE_PRE_LAUNCH=
# Backend: the code team members enter at /dev-access to bypass the landing page in the browser.
# At least 12 characters; generate one with: openssl rand -base64 24. Blank disables the bypass.
PRELAUNCH_ACCESS_CODE=

# ---- Cloudinary (media uploads) ----
# https://console.cloudinary.com/console -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Backup folder used for uploads if Cloudinary is unreachable (optional)
UPLOAD_DIR=uploads

# ---- Rate limiting ----
# Requests allowed per IP for general auth endpoints, per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Stricter limit for endpoints that send an email (signup, resend verification).
EMAIL_RATE_LIMIT_MAX=3
EMAIL_RATE_LIMIT_WINDOW_MINUTES=60

# ---- Reverse proxy (Render) ----
# How many proxies sit in front of the API; rate limits are applied per real client IP using this.
# Leave blank for the default: 1 in production (Render's load balancer), 0 locally. Set it to 2 if
# Vercel forwards /api requests to Render (vercel.json rewrites) instead of the browser calling
# Render directly. Too low and all visitors share one limit; too high and clients can forge their IP.
TRUST_PROXY_HOPS=
